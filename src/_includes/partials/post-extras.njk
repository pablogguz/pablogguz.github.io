{%- set year = page.date | dateYear -%}
{%- set url = page.url | absoluteUrl(site.url) -%}
<footer class="post-extras">
  <section class="author-card" aria-label="about the author">
    <img class="author-avatar" src="/assets/img/avatar.jpg" alt="" width="56" height="56" loading="lazy" decoding="async">
    <div class="author-body">
      <p class="extras-label">written by</p>
      <p class="author-name"><a href="/">{{ site.handle }}</a></p>
      <p class="author-bio">{{ site.bio }}</p>
      <p class="author-links">
        {%- for l in site.links %}{% if not l.url.startsWith("mailto:") %}<a href="{{ l.url }}" target="_blank" rel="noopener noreferrer">{{ l.name | lower }}</a>{% endif %}{% endfor %}
        <a href="/blog/">more writing <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <div class="share-row">
    <span class="extras-label">share</span>
    <button type="button" class="text-btn" id="copy-link" data-link="{{ url }}">copy link</button>
    <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&amp;url={{ url | urlencode }}" target="_blank" rel="noopener">x / twitter</a>
    <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ url | urlencode }}" target="_blank" rel="noopener">linkedin</a>
  </div>

  {%- if kind != "note" and (cite if cite is defined else site.post.cite) %}
  {#- the source is the author's name, properly cased; site.title is the lowercase brand -#}
  <details class="cite">
    <summary>cite this essay</summary>
    <div class="cite-body">
      <div class="cite-block">
        <div class="cite-head"><span class="extras-label">plain text</span><button type="button" class="text-btn cite-copy">copy</button></div>
        <pre class="cite-text">{{ site.authorCitation }} ({{ year }}). “{{ title }}”. {{ site.author }}. {{ url }}</pre>
      </div>
      <div class="cite-block">
        <div class="cite-head"><span class="extras-label">bibtex</span><button type="button" class="text-btn cite-copy">copy</button></div>
        <pre class="cite-text">@misc{{ "{" }}{{ page.fileSlug | bibKey(year) }},
  author = {{ "{" }}{{ site.authorCitation }}},
  title  = {{ "{" }}{{ title }}},
  year   = {{ "{" }}{{ year }}},
  month  = {{ "{" }}{{ page.date | dateMonth }}},
  url    = {{ "{" }}{{ url }}},
  note   = {{ "{" }}{{ site.author }}}
}</pre>
      </div>
    </div>
  </details>
  {%- endif %}

  {%- set posts = collections.posts -%}
  {%- set idx = -1 -%}
  {%- for p in posts %}{% if p.url == page.url %}{% set idx = loop.index0 %}{% endif %}{% endfor -%}
  {%- set newer = posts[idx - 1] if idx > 0 else null -%}
  {%- set older = posts[idx + 1] if (idx >= 0 and idx + 1 < posts.length) else null -%}
  {%- if newer or older %}
  <nav class="post-nav" aria-label="more writing">
    {%- if newer %}
    <a class="post-nav-item newer" href="{{ newer.url }}"><span class="extras-label">← newer</span><span class="post-nav-title"><span class="post-name">{{ newer.data.title }}</span></span></a>
    {%- else %}<span></span>{% endif %}
    {%- if older %}
    <a class="post-nav-item older" href="{{ older.url }}"><span class="extras-label">older →</span><span class="post-nav-title"><span class="post-name">{{ older.data.title }}</span></span></a>
    {%- endif %}
  </nav>
  {%- endif %}
</footer>
