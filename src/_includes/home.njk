---
layout: base.njk
bodyClass: home
---
{#- the bio (index.md) is split at its `<!-- apps -->` marker so the apps
    sit on the first screen: greeting and first paragraph, the apps panel,
    then the rest of the bio and the links, then the writing -#}
{%- set bio = content.split("<!-- apps -->") %}
<section class="wrap home-intro">
  <img class="avatar" src="/assets/img/avatar.jpg" alt="" width="88" height="88" loading="eager" decoding="async">
  <div class="prose home-prose">
    {{ bio[0] | safe }}
  </div>
</section>

<section class="wrap home-apps">
  <h2 class="section-label">apps</h2>
  {% include "partials/apps-dock.njk" %}
  <a class="more-link" href="/projects/">all projects →</a>
</section>

<section class="wrap home-about">
  {%- if bio[1] %}
  <div class="prose home-prose">
    {{ bio[1] | safe }}
  </div>
  {%- endif %}
  <ul class="social" aria-label="elsewhere">
    {%- for l in site.links %}
    <li><a href="{{ l.url }}" aria-label="{{ l.name }}"{% if not l.url.startsWith("mailto:") %} target="_blank" rel="noopener noreferrer"{% endif %}>{% icon l.icon %}<span>{{ l.name | lower }}</span></a></li>
    {%- endfor %}
  </ul>
</section>

<section class="wrap home-recent">
  <h2 class="section-label">recent writing</h2>
  <ol class="post-list">
    {%- for post in collections.posts | head(4) %}
    <li class="post-item">
      <a class="post-link" href="{{ post.url }}">
        <span class="post-title">{{ post.data.title }}</span>
        <span class="post-meta">{{ post.date | dateDisplay }}{% if post.data.kind == "note" %} · note{% endif %}</span>
      </a>
    </li>
    {%- endfor %}
  </ol>
  <a class="more-link" href="/blog/">all writing →</a>
</section>
