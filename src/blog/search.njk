---
permalink: /blog/search.json
eleventyExcludeFromCollections: true
---
{#- the blog search index (site.js): every post's title, blurb and plain text -#}
[{%- for p in collections.posts %}
{"url": {{ p.url | dump | safe }}, "title": {{ p.data.title | dump | safe }}, "desc": {{ (p.data.description or (p.templateContent | excerpt(220))) | dump | safe }}, "text": {{ p.templateContent | searchText | dump | safe }}}{% if not loop.last %},{% endif %}
{%- endfor %}]
